<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notificaciones de nivel de batería -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reagendar alarmas tras reinicio o cambio de zona horaria -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Alarmas exactas para notificaciones en el porcentaje exacto -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Vibración en notificaciones críticas -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Leer estadísticas de batería (para API 29+) -->
    <uses-permission android:name="android.permission.BATTERY_STATS" />

    <!-- Acceso a almacenamiento para sonidos personalizados -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BatteryNotifier">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BatteryNotifier">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity para alerta de pantalla completa (Invasive 1 y 3) -->
        <activity
            android:name=".ui.alert.FullScreenAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.BatteryNotifier.FullScreen" />

        <!-- Recibe alarmas de nivel bajo de batería -->
        <receiver
            android:name=".data.alarm.BatteryThresholdReceiver"
            android:exported="false" />

        <!-- Reagenda alarmas tras reinicios o cambios de hora/zona -->
        <receiver
            android:name=".data.alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- También escuchar cambios de estado de batería -->
                <action android:name="android.intent.action.BATTERY_CHANGED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Servicio en primer plano para monitoreo continuo (opcional) -->
        <service
            android:name=".data.battery.BatteryMonitoringService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>